using Gtk 4.0;
using Adw 1;
using Granite 7.0;

template $Window: Adw.ApplicationWindow {
  title: _("Kyou");
  default-width: 360;
  default-height: 720;

  content: Adw.ToolbarView {
    content: Overlay {
      child: Adw.ViewStack view_stack {
        Adw.ViewStackPage {
          name: "today";
          title: _("Today");
          icon-name: "x-office-calendar-symbolic";

          child: Adw.ToolbarView {
            [top]
            Adw.HeaderBar {
              height-request: 42;

              [end]
              MenuButton {
                tooltip-text: _("Main Menu");
                icon-name: "open-menu-symbolic";
                primary: true;

                menu-model: menu {
                  item (_("About Kyou"), "app.about")
                };
              }
            }

            content: ScrolledWindow {
              hscrollbar-policy: never;
              vscrollbar-policy: automatic;

              child: Adw.Clamp {
                maximum-size: 600;
                tightening-threshold: 400;

                child: Box {
                  orientation: vertical;
                  spacing: 24;
                  margin-top: 34;
                  margin-bottom: 80;
                  margin-start: 28;
                  margin-end: 28;

                  Box {
                    orientation: vertical;
                    spacing: 6;

                    Granite.HeaderLabel greeting_label {
                      halign: start;
                      label: _("good morning! 🌸");
                      size: h1;

                      styles [
                        "kyou-greeting",
                      ]
                    }

                    Label date_label {
                      halign: start;
                      label: _("wednesday, 29 july");

                      styles [
                        "dim-label",
                      ]
                    }
                  }

                  Box {
                    orientation: vertical;
                    spacing: 4;

                    $NowCard {
                      icon-text: "⏰";
                      time-text: "14:15 · NOW";
                      title-text: _("water the plants 🪴");
                      subtitle-text: _("1h 15m");
                      tilt-class: "tilt-left";
                      sticker-type: "washi-tape";
                    }

                    $GapRow {
                      emoji-text: "☕";
                      text-text: _("15m break");
                    }

                    $TodayCard {
                      icon-text: "📝";
                      time-text: "15:30";
                      title-text: _("reply to emails 📩");
                      subtitle-text: _("15m");
                      tilt-class: "tilt-right";
                      sticker-type: "washi-tape-right";
                    }

                    $GapRow {
                      emoji-text: "🌤️";
                      text-text: _("3h free time");
                    }

                    $TodayCard {
                      icon-text: "🌙";
                      time-text: "18:30";
                      title-text: _("read a chapter 📚");
                      subtitle-text: _("1h");
                      tilt-class: "tilt-left";
                      sticker-type: "pin";
                    }

                    $GapRow {
                      emoji-text: "🌙";
                      text-text: _("20m → time left of day");
                    }
                  }
                };
              };
            };
          };
        }

        Adw.ViewStackPage {
          name: "reminders";
          title: _("Reminders");
          icon-name: "edit-paste-symbolic";

          child: Adw.ToolbarView {
            [top]
            Adw.HeaderBar {
              [end]
              MenuButton {
                tooltip-text: _("Main Menu");
                icon-name: "open-menu-symbolic";
                primary: true;

                menu-model: menu {
                  item (_("About Kyou"), "app.about")
                };
              }

              [end]
              Button add_item_button {
                tooltip-text: _("Create Item");
                icon-name: "list-add-symbolic";
                clicked => $on_add_item_clicked();
              }
            }

            content: ScrolledWindow {
              hscrollbar-policy: never;
              vscrollbar-policy: automatic;

              child: Adw.Clamp {
                maximum-size: 800;
                tightening-threshold: 600;

                child: Box {
                  orientation: vertical;
                  spacing: 24;
                  margin-top: 24;
                  margin-bottom: 80;
                  margin-start: 28;
                  margin-end: 28;

                  Box {
                    orientation: vertical;
                    spacing: 8;

                    Button {
                      halign: start;
                      can-target: false;
                      label: _("▲ HIGH");

                      styles [
                        "pill",
                        "destructive-action",
                      ]
                    }

                    ListBox {
                      selection-mode: none;

                      styles [
                        "boxed-list",
                      ]

                      Box {
                        orientation: horizontal;
                        spacing: 12;
                        valign: center;
                        margin-top: 12;
                        margin-bottom: 12;
                        margin-start: 4;
                        margin-end: 4;

                        CheckButton {
                          valign: center;
                        }

                        Label {
                          halign: start;
                          xalign: 0;
                          hexpand: true;
                          wrap: true;
                          label: _("buy stationery");
                        }
                      }

                      Box {
                        orientation: horizontal;
                        spacing: 12;
                        valign: center;
                        margin-top: 12;
                        margin-bottom: 12;
                        margin-start: 4;
                        margin-end: 4;

                        CheckButton {
                          valign: center;
                        }

                        Label {
                          halign: start;
                          xalign: 0;
                          hexpand: true;
                          wrap: true;
                          label: _("tidy the desk");
                        }

                        Label {
                          valign: center;
                          label: _("6pm");

                          styles [
                            "caption",
                            "dim-label",
                          ]
                        }
                      }
                    }
                  }

                  Box {
                    orientation: vertical;
                    spacing: 8;

                    Button {
                      halign: start;
                      can-target: false;
                      label: _("● MEDIUM");

                      styles [
                        "pill",
                        "warning",
                      ]
                    }

                    ListBox {
                      selection-mode: none;

                      styles [
                        "boxed-list",
                      ]

                      Box {
                        orientation: horizontal;
                        spacing: 12;
                        valign: center;
                        margin-top: 12;
                        margin-bottom: 12;
                        margin-start: 4;
                        margin-end: 4;

                        CheckButton {
                          valign: center;
                          active: true;
                        }

                        Label {
                          halign: start;
                          xalign: 0;
                          hexpand: true;
                          wrap: true;
                          label: _("charge headphones");

                          styles [
                            "dim-label",
                          ]
                        }
                      }

                      Box {
                        orientation: horizontal;
                        spacing: 12;
                        valign: center;
                        margin-top: 12;
                        margin-bottom: 12;
                        margin-start: 4;
                        margin-end: 4;

                        CheckButton {
                          valign: center;
                        }

                        Label {
                          halign: start;
                          xalign: 0;
                          hexpand: true;
                          wrap: true;
                          label: _("book a haircut");
                        }

                        Label {
                          valign: center;
                          label: _("fri");

                          styles [
                            "caption",
                            "dim-label",
                          ]
                        }
                      }
                    }
                  }

                  Box {
                    orientation: vertical;
                    spacing: 8;

                    Button {
                      halign: start;
                      can-target: false;
                      label: _("▼ LOW");

                      styles [
                        "pill",
                        "success",
                      ]
                    }

                    ListBox {
                      selection-mode: none;

                      styles [
                        "boxed-list",
                      ]

                      Box {
                        orientation: horizontal;
                        spacing: 12;
                        valign: center;
                        margin-top: 12;
                        margin-bottom: 12;
                        margin-start: 4;
                        margin-end: 4;

                        CheckButton {
                          valign: center;
                        }

                        Label {
                          halign: start;
                          xalign: 0;
                          hexpand: true;
                          wrap: true;
                          label: _("restock stationery drawer");
                        }
                      }
                    }
                  }
                };
              };
            };
          };
        }
      };

      [overlay]
      Adw.ViewSwitcherBar {
        stack: view_stack;
        reveal: true;
        valign: end;
        halign: center;
      }
    };
  };
}
