<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Kyou</name>
  <summary>Today's agenda and tasks</summary>
  <description>
    <p>
      Kyou is a focused task and calendar manager designed to answer one simple question: what am I meant to be doing right now?
    </p>
    <p>
      Instead of overwhelming you with endless lists and complicated calendar views, Kyou gathers your schedule and reminders into a single, clean, and intuitive overview.
    </p>
  </description>

  <developer id="casa.bnuuy">
    <name translate="no">sanabunny</name>
  </developer>

  <url type="homepage">https://bnuuy.casa/</url>
  <url type="vcs-browser">https://github.com/sanabunny/kyou</url>
  <url type="bugtracker">https://github.com/sanabunny/kyou/issues</url>
  <url type="contact">https://github.com/sanabunny/kyou/issues</url>

  <translation type="gettext">kyou</translation>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <content_rating type="oars-1.1" />

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <branding>
    <color type="primary" scheme_preference="light">#613f27</color>
    <color type="primary" scheme_preference="dark">#4b3526</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <caption>Today tab showing your schedule at a glance</caption>
      <image>https://raw.githubusercontent.com/sanabunny/kyou/main/data/screenshots/today.png</image>
    </screenshot>
    <screenshot>
      <caption>Reminders tab showing your task lists</caption>
      <image>https://raw.githubusercontent.com/sanabunny/kyou/main/data/screenshots/reminders.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.1.0" date="2026-09-17">
      <description>
        <p>Initial release with calendar and reminders support, today view, and adaptive UI.</p>
      </description>
    </release>
  </releases>

</component>
