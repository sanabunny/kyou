using Gtk 4.0;
using Adw 1;

template $ReminderInfoDialog: Adw.Dialog {
  content-width: 420;
  content-height: 560;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button close_button {
        tooltip-text: _("Close");
        icon-name: "window-close-symbolic";
        clicked => $on_close_clicked();
      }
    }

    content: ScrolledWindow {
      hscrollbar-policy: never;
      vscrollbar-policy: automatic;

      child: Adw.Clamp {
        maximum-size: 600;
        tightening-threshold: 400;

        child: Box {
          orientation: vertical;
          spacing: 24;
          margin-start: 18;
          margin-end: 18;
          margin-top: 18;
          margin-bottom: 24;

          Box rows_box {
            orientation: vertical;
            spacing: 18;
          }
        };
      };
    };
  };
}
